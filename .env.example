# Spotify CLI 환경 변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env

# Spotify Developer Dashboard에서 생성한 Client ID
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here

# OAuth 콜백 포트 (선택사항, 기본값: 8080)
# Spotify Developer Dashboard에서 Redirect URI를 https://127.0.0.1:{포트}/callback 으로 설정하세요.
SPOTIFY_REDIRECT_PORT=8080
